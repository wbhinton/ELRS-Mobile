---
interface Props {
	id?: string;
	title: string;
	subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<section id={id} class="py-12 md:py-16 scroll-mt-20">
	<header class="text-center mb-8 md:mb-12">
		<h2 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-3">{title}</h2>
		{subtitle && <p class="text-lg md:text-xl text-text-muted max-w-2xl mx-auto">{subtitle}</p>}
	</header>
	<slot />
</section>
