---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { useTranslations, type UIKey } from "../i18n";
import { links } from "../config/site";

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// "Label: description" list items.
const item = (label: UIKey, desc: UIKey) => ({ label: t(label), desc: t(desc) });

const stored = [
	item("privacy.local_profiles_label", "privacy.local_profiles_desc"),
	item("privacy.local_prefs_label", "privacy.local_prefs_desc"),
	item("privacy.local_cache_label", "privacy.local_cache_desc"),
];
const permissions = [
	item("privacy.perm_network_label", "privacy.perm_network_desc"),
	item("privacy.perm_local_label", "privacy.perm_local_desc"),
	item("privacy.perm_files_label", "privacy.perm_files_desc"),
];
const services: UIKey[] = ["privacy.network_firmware", "privacy.network_updates", "privacy.network_device"];

// "{github}" / "{discord}" placeholders become links.
const contactLinks: Record<string, { href: string; label: string }> = {
	github: { href: `${links.repo}/issues`, label: t("privacy.contact_github") },
	discord: { href: links.elrsDiscord, label: t("privacy.contact_discord") },
};
const contactParts = t("privacy.contact_desc").split(/\{(\w+)\}/);
---

<StarlightPage
	frontmatter={{
		title: `${t("privacy.title_main")} ${t("privacy.title_sub")}`,
		tableOfContents: false,
	}}
	hasSidebar={false}
>
	<p><em>{t("privacy.last_updated")}</em></p>
	<p>{t("privacy.intro")}</p>

	<h2>{t("privacy.local_title")}</h2>
	<ul>{stored.map(({ label, desc }) => <li><strong>{label}</strong>: {desc}</li>)}</ul>
	<p>{t("privacy.local_note")}</p>

	<h2>{t("privacy.analytics_title")}</h2>
	<p>{t("privacy.analytics_desc")}</p>
	<p>{t("privacy.analytics_never")}</p>
	<p><strong>{t("privacy.analytics_optout")}</strong></p>

	<h2>{t("privacy.crash_title")}</h2>
	<p>{t("privacy.crash_desc")}</p>
	<p>{t("privacy.crash_toggle")}</p>
	<p>{t("privacy.crash_debug")}</p>

	<h2>{t("privacy.network_title")}</h2>
	<p>{t("privacy.network_desc")}</p>
	<ul>{services.map((key) => <li>{t(key)}</li>)}</ul>

	<h2>{t("privacy.permissions_title")}</h2>
	<ul>{permissions.map(({ label, desc }) => <li><strong>{label}</strong>: {desc}</li>)}</ul>
	<p>{t("privacy.permissions_location")}</p>

	<h2>{t("privacy.website_title")}</h2>
	<p>{t("privacy.website_desc")}</p>

	<h2>{t("privacy.security_title")}</h2>
	<p>{t("privacy.security_desc")}</p>

	<h2>{t("privacy.changes_title")}</h2>
	<p>{t("privacy.changes_desc")}</p>

	<h2>{t("privacy.contact_title")}</h2>
	<p>
		{
			contactParts.map((part, i) =>
				i % 2 === 1 && contactLinks[part] ? (
					<a href={contactLinks[part].href}>{contactLinks[part].label}</a>
				) : (
					part
				)
			)
		}
	</p>
</StarlightPage>
