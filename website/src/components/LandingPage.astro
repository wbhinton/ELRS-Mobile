---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { useTranslations } from "../i18n";
import { links } from "../config/site";
import {
	stores,
	heroScreen,
	useCases,
	demoVideo,
	communityVideos,
	altInstalls,
} from "../data/landing";
import Section from "./landing/Section.astro";
import Card from "./landing/Card.astro";
import Steps from "./landing/Steps.astro";
import FeatureTour from "./landing/FeatureTour.astro";
import VideoEmbed from "./landing/VideoEmbed.astro";
import StoreBadges from "./landing/StoreBadges.astro";
import HardwareSummary from "./landing/HardwareSummary.astro";

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<StarlightPage
	frontmatter={{
		title: t("meta.title"),
		description: t("meta.description"),
		template: "splash",
		// Keep the full marketing title instead of "<title> | ELRS Mobile".
		head: [{ tag: "title", content: t("meta.title") }],
		hero: {
			title: t("hero.title"),
			tagline: t("hero.subtitle"),
			image: { file: heroScreen, alt: t("hero.image_alt") },
			actions: stores.map((store) => ({
				text: t(store.label),
				link: store.href,
				variant: "primary" as const,
				attrs: { "data-track": "app_download_click", "data-store": store.id },
			})),
		},
	}}
>
	<div class="not-content text-white">
		<p class="text-xs text-text-muted text-center md:text-left -mt-4 pb-4">
			{t("hero.play_beta_blurb")} <a href={links.playBeta} class="text-primary" target="_blank" rel="noopener">{t("hero.play_beta_link")}</a>.
			<span class="mx-3 opacity-30">|</span>
			{t("hero.testflight_beta_blurb")} <a href={links.testFlight} class="text-primary" target="_blank" rel="noopener">{t("hero.testflight_beta_link")}</a>.
		</p>

		<Section id="how-it-works" title={t("how.title")} subtitle={t("how.subtitle")}>
			<div class="grid items-center gap-10 md:grid-cols-[1fr_260px]">
				<Steps lang={lang} />
				<div class="w-full max-w-[260px] mx-auto rounded-[2rem] overflow-hidden border-[6px] border-surface shadow-2xl">
					<VideoEmbed video={{ ...demoVideo, title: t("demo.video_title") }} playLabel={t("videos.play")} />
				</div>
			</div>
		</Section>

		<Section id="features" title={t("features.title")} subtitle={t("features.subtitle")}>
			<FeatureTour lang={lang} />
		</Section>

		<Section id="use-cases" title={t("why.title")} subtitle={t("why.subtitle")}>
			<div class="grid gap-6 md:grid-cols-2">
				{
					useCases.map((useCase) => (
						<Card class="flex flex-col gap-4">
							<span class="self-start text-[0.7rem] font-extrabold uppercase tracking-wider px-2.5 py-1.5 rounded-lg bg-primary/10 text-primary">
								{t(useCase.label)}
							</span>
							<h3 class="text-xl md:text-2xl font-bold">{t(useCase.title)}</h3>
							<p class="text-text-muted leading-relaxed grow">{t(useCase.body)}</p>
							<div class="p-5 bg-primary/5 rounded-xl border-l-[3px] border-primary">
								<strong class="block text-primary mb-1">{t(useCase.fixTitle)}</strong>
								{t(useCase.fixBody)}
							</div>
						</Card>
					))
				}
			</div>
		</Section>

		<Section id="hardware" title={t("hardware.title")} subtitle={t("hardware.subtitle")}>
			<HardwareSummary lang={lang} />
		</Section>

		<Section id="videos" title={t("video_guides.title")} subtitle={t("video_guides.subtitle")}>
			<div class="grid gap-6 md:grid-cols-2">
				{
					communityVideos.map((video) => (
						<Card class="!p-0 overflow-hidden flex flex-col">
							<VideoEmbed video={video} playLabel={t("videos.play")} />
							<div class="p-6">
								<h3 class="font-bold text-lg leading-snug mb-2">{video.title}</h3>
								{video.body && <p class="text-text-muted text-sm leading-relaxed">{t(video.body)}</p>}
							</div>
						</Card>
					))
				}
			</div>
		</Section>

		<Section id="installation" title={t("get_started.title")} subtitle={t("get_started.subtitle")}>
			<StoreBadges lang={lang} class="mb-10" />
			<h3 class="text-center text-xl font-bold mb-1">{t("get_started.advanced_title")}</h3>
			<p class="text-center text-text-muted text-sm mb-6">{t("get_started.advanced_subtitle")}</p>
			<div class="grid gap-4 md:grid-cols-3">
				{
					altInstalls.map((option) => (
						<Card
							href={option.href}
							class="!p-5"
							data-track={option.track && "app_download_click"}
							data-store={option.track}
						>
							<h4 class="font-bold mb-1">{t(option.title)}</h4>
							<p class="text-text-muted text-sm">{t(option.body)}</p>
						</Card>
					))
				}
			</div>
		</Section>
	</div>
</StarlightPage>
