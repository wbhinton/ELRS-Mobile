---
import Layout from "../layouts/Layout.astro";
import ui from "../i18n/ui.json";

interface Props {
	lang: string;
}

const { lang } = Astro.props;

// Helper to look up keys safely
function t(key: keyof typeof ui.en): string {
  const dictionary = (ui as any)[lang] || ui.en;
  return dictionary[key] || (ui.en as any)[key];
}

// Adjust links for non-english locales
const localizedPath = (path: string) => {
  if (lang === 'en') return path;
  return `/${lang}${path}`;
};
---

<Layout 
	title={t("meta.title")} 
	description={t("meta.description")}
	lang={lang}
>
