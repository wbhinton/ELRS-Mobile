---
// Full supported-hardware list for the docs page, grouped by brand, with a
// client-side search filter. Data: src/data/hardware.ts.
import { devicesByBrand, hardwareStats, type Device } from '../data/hardware';
import { useTranslations, defaultLocale, format, formatNumber } from '../i18n';

const lang = Astro.locals.starlightRoute.locale ?? defaultLocale;
const t = useTranslations(lang);

const bandLabel: Record<Device['band'], string> = {
	'2400': '2.4 GHz',
	'900': '900 MHz',
	dual: t('hardware.band_dual'),
};
---

<div class="hardware-list not-content">
	<p class="text-text-muted mb-2">{t('hardware.list_intro')}</p>
	<p class="text-sm text-text-muted mb-5">
		{
			format(t('hardware.summary'), {
				devices: formatNumber(lang, hardwareStats.devices),
				brands: formatNumber(lang, hardwareStats.brands),
				verified: formatNumber(lang, hardwareStats.verified),
			})
		}
	</p>

	<label class="block mb-6">
		<span class="sr-only">{t('hardware.filter_label')}</span>
		<input
			type="search"
			data-hardware-filter
			placeholder={t('hardware.filter_placeholder')}
			class="w-full rounded-lg border border-white/10 bg-surface px-4 py-2.5 text-white placeholder:text-text-muted/60 focus:border-primary focus:outline-none"
		/>
	</label>

	<p data-hardware-empty hidden class="text-text-muted">{t('hardware.no_match')}</p>

	{
		devicesByBrand.map(([brand, devices]) => (
			<section data-hardware-brand class="mb-8">
				<h3 class="text-lg font-bold text-white mb-3">{brand}</h3>
				<ul class="grid gap-2 sm:grid-cols-2 list-none p-0 m-0">
					{devices.map((device) => (
						<li
							data-search={`${brand} ${device.name}`.toLowerCase()}
							class="flex items-start justify-between gap-3 rounded-lg border border-white/5 bg-surface/40 px-3 py-2"
						>
							<div>
								<div class="text-sm text-white">{device.name}</div>
								<div class="text-xs text-text-muted">
									{device.role.toUpperCase()} · {bandLabel[device.band]} · {device.chip}
								</div>
							</div>
							{device.verified && (
								<span class="flex-none rounded-md bg-primary/15 border border-primary/30 px-2 py-0.5 text-[0.7rem] font-bold text-primary">
									✓ {t('hardware.verified_badge')}
								</span>
							)}
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<script>
	const input = document.querySelector<HTMLInputElement>('[data-hardware-filter]');
	const empty = document.querySelector<HTMLElement>('[data-hardware-empty]');
	input?.addEventListener('input', () => {
		const query = input.value.trim().toLowerCase();
		let any = false;
		for (const brand of document.querySelectorAll<HTMLElement>('[data-hardware-brand]')) {
			let visible = 0;
			for (const item of brand.querySelectorAll<HTMLElement>('[data-search]')) {
				const match = item.dataset.search!.includes(query);
				item.hidden = !match;
				if (match) visible++;
			}
			brand.hidden = visible === 0;
			any ||= visible > 0;
		}
		if (empty) empty.hidden = any;
	});
</script>
