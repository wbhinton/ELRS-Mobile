---
import LandingPage from "../../components/LandingPage.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "de" } },
    { params: { lang: "es" } },
    { params: { lang: "fr" } },
    { params: { lang: "ja" } },
    { params: { lang: "uk" } },
  ];
}

const { lang } = Astro.params;
---

<LandingPage lang={lang} />
